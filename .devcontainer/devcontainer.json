{
	"name": "artefact",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"containerUser": "artefact",
	"remoteUser": "artefact",
	"runArgs": [
		"--hostname=artefact",
		"--cap-add",
		"PERFMON",
		// AMD/Intel GPUs via DRM render nodes (Mesa RADV/ANV/lavapipe in the image).
		// NOTE: no `--gpus=all` here — that's Docker/NVIDIA syntax. VS Code's
		// devcontainer CLI probes it via `podman info -f {{.Runtimes.nvidia}}`,
		// which fails on Podman 5 (`can't evaluate field Runtimes`) and aborts
		// open even when hostRequirements.gpu is only "optional". NVIDIA hosts
		// should re-add it locally; this repo's hosts (Bazzite/AMD) use /dev/dri.
		"--device=/dev/dri",
		"-v",
		"cargo-cache:/usr/local/cargo"
	],
	"hostRequirements": {
		"gpu": false
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"Vue.volar",
				"bradlc.vscode-tailwindcss",
				"esbenp.prettier-vscode",
				"YoavBls.pretty-ts-errors",
				"tamasfe.even-better-toml",
				"fill-labs.dependi"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"prettier.configPath": ".prettierrc",
				"[vue]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"[typescript]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"[json]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"[css]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				}
			}
		}
	},
	"postCreateCommand": "bash .devcontainer/postinstall.sh"
}
